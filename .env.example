# Copy to .env (git-ignored) and adjust. Never commit .env.
#
# Values here also override the ${VAR} defaults inside the official
# openmetadata/docker-compose.yml, so keep every lab variable prefixed
# (SOURCE_*, DQLAB_*) to avoid reconfiguring OpenMetadata by accident.

# Source MySQL (Phase 1). The seeder connects to 127.0.0.1:SOURCE_MYSQL_PORT;
# OpenMetadata connects to source-mysql:3306 on the Docker network.
SOURCE_MYSQL_PORT=3307
SOURCE_MYSQL_ROOT_PASSWORD=change-me-root
SOURCE_MYSQL_USER=dqlab
SOURCE_MYSQL_PASSWORD=change-me

# Source Oracle (Phase 2, compose profile "oracle"). The seeder connects to
# 127.0.0.1:SOURCE_ORACLE_PORT, service name XEPDB1; OpenMetadata connects to
# source-oracle:1521. SOURCE_ORACLE_USER owns the HR schema.
SOURCE_ORACLE_PORT=1521
SOURCE_ORACLE_SYSTEM_PASSWORD=change-me-system
SOURCE_ORACLE_USER=dqlab
SOURCE_ORACLE_PASSWORD=change-me
